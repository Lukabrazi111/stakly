APP_NAME=Stakly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue

# `failover` = redis → array. A Redis blip degrades to an in-memory tail so the
# homepage, circuit breaker, and rate limiter never 500 (see config/cache.php).
CACHE_STORE=failover
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# `tcp` locally (Sail). Set `tls` in production when the managed Redis enforces
# TLS — e.g. DigitalOcean Managed Redis/Valkey. Applies to all four redis
# connections (default/cache/queue/session) in config/database.php.
REDIS_SCHEME=tcp

# Distinct logical DBs per concern: `cache:clear` (DB 1) must not wipe queued
# settlement jobs (DB 2) or sessions (DB 3). DB 0 = general / Horizon (M38 P3).
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Server-to-server: the laravel.test container talks to the reverb container
# via the Docker service name. The browser uses VITE_REVERB_HOST below, which
# is "localhost" so it can reach the exposed port on the host.
REVERB_HOST="reverb"
REVERB_PORT=8080
REVERB_SCHEME=http

# FACEIT OAuth credentials (M15 Phase 2). Register your app at
# developers.faceit.com → App Studio. One redirect URI per app — dev and
# production each need a separate FACEIT app. FACEIT_REDIRECT_URI must
# match the callback URL exactly: ${APP_URL}/auth/faceit/callback.
# chess.com outbound API self-throttle (M35 Phase 1). Caps
# `AutoFetchChessComGameJob` executions/min to avoid 429s. Default 30
# matches the CLAUDE.md conservative-cap rule for undocumented provider
# limits. Tune up if production headroom is observed.
CHESS_COM_REQUESTS_PER_MINUTE=30

# Lichess outbound API self-throttle (M35 Phase 2). Caps
# `AutoFetchLichessGameJob` executions/min. Default 60 — Lichess
# documents a 20 req/sec global limit (= 1200/min); 60/min leaves
# a 20× safety margin while being well above realistic load.
LICHESS_REQUESTS_PER_MINUTE=60

FACEIT_CLIENT_ID=
FACEIT_CLIENT_SECRET=
FACEIT_REDIRECT_URI=
FACEIT_API_KEY=
# FACEIT outbound API self-throttle (M35 Phase 3). Caps
# `AutoFetchFaceitGameJob` executions/min. Default 30 matches the
# CLAUDE.md conservative-cap rule for undocumented provider limits.
# FACEIT support hasn't confirmed their production-key quota.
FACEIT_REQUESTS_PER_MINUTE=30
# Shared-secret value FACEIT POSTs in the `X-Faceit-Webhook-Secret` header
# on every webhook delivery (M15 P4 Slice 4). Configured in the FACEIT
# developer portal → Webhooks → Authentication. Generate with
# `openssl rand -hex 32` and paste the SAME value into both the FACEIT
# portal and this env. Leave empty in environments that don't receive
# FACEIT webhooks.
FACEIT_WEBHOOK_SECRET=

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Lichess API token
LICHESS_API_TOKEN=

# Payment gateway (M9 — billing / chain integration). `PAYMENTS_DRIVER`
# selects the provider behind `App\Services\Payments\PaymentGateway`:
# `mock` (default, no signup/keys), `nowpayments`, or `cryptomus`. The real
# provider keys below are only consumed once those clients are wired (M9 —
# paused for go-ahead); `mock` ignores them. PAYMENTS_MOCK_WEBHOOK_SECRET
# (e.g. `openssl rand -hex 32`) lets the mock webhook signature path be tested.
PAYMENTS_DRIVER=mock
PAYMENTS_MOCK_NETWORK_FEE=1.500000
PAYMENTS_MOCK_WEBHOOK_SECRET=
NOWPAYMENTS_BASE_URL=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_REQUESTS_PER_MINUTE=30
CRYPTOMUS_BASE_URL=https://api.cryptomus.com
CRYPTOMUS_MERCHANT_UUID=
CRYPTOMUS_PAYMENT_KEY=
CRYPTOMUS_PAYOUT_KEY=
CRYPTOMUS_REQUESTS_PER_MINUTE=30


INERTIA_SSR_URL=http://ssr:13714
